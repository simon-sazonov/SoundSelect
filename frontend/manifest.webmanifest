{
  "name": "SoundSelect",
  "short_name": "SoundSelect",
  "description": "Chord sheets, songs and sheet music, written for your saxophone.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F0EDE6",
  "theme_color": "#F0EDE6",
  "icons": [
    {
      "src": "/app/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/app/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/app/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/app/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
