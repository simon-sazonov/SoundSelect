{
  "$defs": {
    "ChordFix": {
      "additionalProperties": false,
      "description": "Replace a chord: one occurrence (line and index) or, without them, every occurrence.",
      "properties": {
        "original": {
          "description": "The chord as it was read.",
          "title": "Original",
          "type": "string"
        },
        "to": {
          "description": "The right chord, as on the sheet; empty to remove it.",
          "title": "To",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Line number counted across the whole song.",
          "title": "Line"
        },
        "index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Which chord in that line, from 0.",
          "title": "Index"
        }
      },
      "required": [
        "original",
        "to"
      ],
      "title": "ChordFix",
      "type": "object"
    },
    "ChordInfo": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "description": "Concert-pitch symbol; lines refer to chords by it.",
          "title": "Symbol",
          "type": "string"
        },
        "family": {
          "enum": [
            "major",
            "minor",
            "dominant",
            "half_diminished",
            "diminished",
            "augmented",
            "suspended",
            "power"
          ],
          "title": "Family",
          "type": "string"
        },
        "count": {
          "description": "How many times the chord appears.",
          "title": "Count",
          "type": "integer"
        },
        "concert": {
          "$ref": "#/$defs/ChordSpelling"
        },
        "written": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChordSpelling"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scales": {
          "description": "The scale offered over this chord first, then options.",
          "items": {
            "$ref": "#/$defs/ScaleInfo"
          },
          "title": "Scales",
          "type": "array"
        },
        "clashes": {
          "$ref": "#/$defs/Spelled",
          "description": "Notes of the key's pentatonic that rub against this chord."
        }
      },
      "required": [
        "symbol",
        "family",
        "count",
        "concert"
      ],
      "title": "ChordInfo",
      "type": "object"
    },
    "ChordPlacement": {
      "additionalProperties": false,
      "properties": {
        "chord": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Concert symbol (a key into Song.chords); null for 'N.C.' (no chord).",
          "title": "Chord"
        },
        "written": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Written"
        },
        "text": {
          "description": "The chord exactly as it appears in the source.",
          "title": "Text",
          "type": "string"
        },
        "readable": {
          "default": true,
          "description": "False when the text could not be read as a chord.",
          "title": "Readable",
          "type": "boolean"
        },
        "pos": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Letter position in the line, for sheets.",
          "title": "Pos"
        },
        "beat": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Beat from the start, for songs.",
          "title": "Beat"
        }
      },
      "required": [
        "chord",
        "text"
      ],
      "title": "ChordPlacement",
      "type": "object"
    },
    "ChordSpelling": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "description": "ASCII chord symbol, e.g. 'Bb/D'.",
          "title": "Symbol",
          "type": "string"
        },
        "root": {
          "title": "Root",
          "type": "string"
        },
        "quality": {
          "description": "Normalized suffix, e.g. 'm7', 'maj7', 'sus4'.",
          "title": "Quality",
          "type": "string"
        },
        "bass": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bass"
        },
        "tones": {
          "description": "Chord notes from the root up.",
          "items": {
            "type": "string"
          },
          "title": "Tones",
          "type": "array"
        }
      },
      "required": [
        "symbol",
        "root",
        "quality",
        "tones"
      ],
      "title": "ChordSpelling",
      "type": "object"
    },
    "Corrections": {
      "additionalProperties": false,
      "description": "The player's edits, kept apart from what was computed.",
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "artist": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artist"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Concert key, e.g. 'Bb major' or 'Gm'.",
          "title": "Key"
        },
        "capo": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Capo fret (or half steps) instead of the sheet's.",
          "title": "Capo"
        },
        "chords": {
          "items": {
            "$ref": "#/$defs/ChordFix"
          },
          "title": "Chords",
          "type": "array"
        },
        "melody_octave": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Melody Octave"
        },
        "page_instrument": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sheet music: the instrument the page is written for ('alto_sax', or 'concert' for concert pitch), instead of what was read from its part name.",
          "title": "Page Instrument"
        },
        "b_is_flat": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What a plain B on the sheet means: true B♭ (Russian and German sheets), false B natural; null reads it from the sheet.",
          "title": "B Is Flat"
        }
      },
      "title": "Corrections",
      "type": "object"
    },
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "artist": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artist"
        },
        "source": {
          "description": "What the song was read from.",
          "enum": [
            "text",
            "pdf",
            "photo",
            "screenshots",
            "audio",
            "link",
            "video"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "File name or link, when there is one.",
          "title": "Source Name"
        },
        "fingerprint": {
          "description": "SHA-256 of the input, used to spot repeats.",
          "title": "Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "source",
        "fingerprint"
      ],
      "title": "Identity",
      "type": "object"
    },
    "InstrumentView": {
      "additionalProperties": false,
      "properties": {
        "instrument": {
          "description": "Instrument id, e.g. 'alto_sax'.",
          "title": "Instrument",
          "type": "string"
        },
        "name": {
          "description": "Display name, e.g. 'Alto sax in E♭'.",
          "title": "Name",
          "type": "string"
        },
        "interval": {
          "description": "Interval from concert to written pitch: 'M6' for alto sax, or 'd7' when the written key is respelled to avoid more than six sharps.",
          "title": "Interval",
          "type": "string"
        },
        "respelled": {
          "default": false,
          "title": "Respelled",
          "type": "boolean"
        },
        "written_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "comfortable_low": {
          "description": "Lowest comfortable written note, e.g. 'C4'.",
          "title": "Comfortable Low",
          "type": "string"
        },
        "comfortable_high": {
          "description": "Highest comfortable written note, e.g. 'C6'.",
          "title": "Comfortable High",
          "type": "string"
        }
      },
      "required": [
        "instrument",
        "name",
        "interval",
        "comfortable_low",
        "comfortable_high"
      ],
      "title": "InstrumentView",
      "type": "object"
    },
    "KeyCandidate": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/KeyName"
        },
        "probability": {
          "title": "Probability",
          "type": "number"
        }
      },
      "required": [
        "key",
        "probability"
      ],
      "title": "KeyCandidate",
      "type": "object"
    },
    "KeyName": {
      "additionalProperties": false,
      "properties": {
        "tonic": {
          "description": "Spelled tonic, e.g. 'Bb'.",
          "title": "Tonic",
          "type": "string"
        },
        "mode": {
          "enum": [
            "major",
            "minor"
          ],
          "title": "Mode",
          "type": "string"
        },
        "fifths": {
          "description": "Key signature: sharps positive, flats negative.",
          "title": "Fifths",
          "type": "integer"
        }
      },
      "required": [
        "tonic",
        "mode",
        "fifths"
      ],
      "title": "KeyName",
      "type": "object"
    },
    "KeyResult": {
      "additionalProperties": false,
      "properties": {
        "concert": {
          "$ref": "#/$defs/KeyName",
          "description": "The song's key in concert pitch."
        },
        "confidence": {
          "description": "0-1: how sure this exact key is.",
          "title": "Confidence",
          "type": "number"
        },
        "signature_confidence": {
          "description": "0-1: how sure the key signature is (this key or its relative major/minor, which share the pentatonic notes).",
          "title": "Signature Confidence",
          "type": "number"
        },
        "runners_up": {
          "items": {
            "$ref": "#/$defs/KeyCandidate"
          },
          "title": "Runners Up",
          "type": "array"
        },
        "basis": {
          "default": "chords",
          "enum": [
            "chords",
            "stated",
            "melody",
            "signature",
            "correction"
          ],
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "concert",
        "confidence",
        "signature_confidence"
      ],
      "title": "KeyResult",
      "type": "object"
    },
    "Line": {
      "additionalProperties": false,
      "properties": {
        "lyrics": {
          "default": "",
          "title": "Lyrics",
          "type": "string"
        },
        "chords": {
          "items": {
            "$ref": "#/$defs/ChordPlacement"
          },
          "title": "Chords",
          "type": "array"
        },
        "repeat": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Play the line this many times ('x2').",
          "title": "Repeat"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Line",
      "type": "object"
    },
    "Melody": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "items": {
            "$ref": "#/$defs/MelodyNote"
          },
          "title": "Notes",
          "type": "array"
        },
        "octave_shift": {
          "default": 0,
          "description": "Octaves the written melody is moved to fit the comfortable range.",
          "title": "Octave Shift",
          "type": "integer"
        },
        "source": {
          "enum": [
            "audio",
            "sheet_music"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "Melody",
      "type": "object"
    },
    "MelodyNote": {
      "additionalProperties": false,
      "properties": {
        "concert": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Concert pitch with octave; null for a rest.",
          "title": "Concert"
        },
        "written": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Written"
        },
        "start": {
          "description": "Start in beats from the beginning.",
          "title": "Start",
          "type": "number"
        },
        "length": {
          "description": "Length in beats.",
          "title": "Length",
          "type": "number"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "out_of_range": {
          "default": false,
          "title": "Out Of Range",
          "type": "boolean"
        }
      },
      "required": [
        "concert",
        "start",
        "length"
      ],
      "title": "MelodyNote",
      "type": "object"
    },
    "Notice": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "default": "info",
          "enum": [
            "info",
            "warning"
          ],
          "title": "Level",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Notice",
      "type": "object"
    },
    "ScaleInfo": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "major_pentatonic",
            "minor_pentatonic",
            "blues",
            "major",
            "natural_minor",
            "arpeggio"
          ],
          "title": "Kind",
          "type": "string"
        },
        "role": {
          "description": "'headline' is the key's pentatonic, shown first; 'song' other whole-song scales; 'chord' the scale offered over a chord; 'alternative' another option.",
          "enum": [
            "headline",
            "song",
            "chord",
            "alternative"
          ],
          "title": "Role",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "concert": {
          "$ref": "#/$defs/ScaleSpelling"
        },
        "written": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScaleSpelling"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "role",
        "reason",
        "concert"
      ],
      "title": "ScaleInfo",
      "type": "object"
    },
    "ScaleSpelling": {
      "additionalProperties": false,
      "properties": {
        "root": {
          "title": "Root",
          "type": "string"
        },
        "notes": {
          "description": "Scale notes without octaves.",
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "staff": {
          "description": "The notes with octaves as drawn on the staff, rising one octave.",
          "items": {
            "type": "string"
          },
          "title": "Staff",
          "type": "array"
        }
      },
      "required": [
        "root",
        "notes"
      ],
      "title": "ScaleSpelling",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "other",
          "enum": [
            "intro",
            "verse",
            "pre_chorus",
            "chorus",
            "bridge",
            "solo",
            "instrumental",
            "interlude",
            "outro",
            "coda",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The label as written, e.g. 'Припев'.",
          "title": "Label"
        },
        "repeat": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Play the section this many times ('x2').",
          "title": "Repeat"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/Line"
          },
          "title": "Lines",
          "type": "array"
        }
      },
      "title": "Section",
      "type": "object"
    },
    "SheetMusicInfo": {
      "additionalProperties": false,
      "description": "What a piece of sheet music was read from and how (Phase 3).",
      "properties": {
        "page_instrument": {
          "default": "concert",
          "description": "The instrument the page is written for: 'concert' for concert pitch, or e.g. 'alto_sax'. A page already written for alto is not transposed twice.",
          "title": "Page Instrument",
          "type": "string"
        },
        "part_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The part name as read on the page.",
          "title": "Part Name"
        },
        "systems": {
          "description": "Lines of music (systems) kept after joining the views.",
          "title": "Systems",
          "type": "integer"
        },
        "measures": {
          "description": "Bars read.",
          "title": "Measures",
          "type": "integer"
        },
        "views": {
          "description": "Screenshots, or views taken from the video, that were used.",
          "title": "Views",
          "type": "integer"
        }
      },
      "required": [
        "systems",
        "measures",
        "views"
      ],
      "title": "SheetMusicInfo",
      "type": "object"
    },
    "SourcePage": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        }
      },
      "required": [
        "index"
      ],
      "title": "SourcePage",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "box": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "x0, y0, x1, y1 on the page image, in pixels.",
          "title": "Box"
        }
      },
      "required": [
        "page"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "Spelled": {
      "additionalProperties": false,
      "description": "The same pitches in concert pitch and as written for the instrument.",
      "properties": {
        "concert": {
          "items": {
            "type": "string"
          },
          "title": "Concert",
          "type": "array"
        },
        "written": {
          "items": {
            "type": "string"
          },
          "title": "Written",
          "type": "array"
        }
      },
      "title": "Spelled",
      "type": "object"
    },
    "Timing": {
      "additionalProperties": false,
      "properties": {
        "tempo": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Beats per minute.",
          "title": "Tempo"
        },
        "time_signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Signature"
        },
        "beat_times": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Beat times in seconds (songs).",
          "title": "Beat Times"
        },
        "downbeats": {
